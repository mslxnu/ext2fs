<?xml version="1.0" encoding="UTF-8"?>
<!--
  pkgbuild component settings for the ext2fs payload.

  All payloads are bundles or plists - ext2fs.kext, ext2fs.fs, and the
  com.beako.ext2fs LaunchDaemon - and pkgbuild marks bundles relocatable by
  default. A relocatable payload is redirected to wherever the installer finds
  an existing bundle with the same identifier, which for anyone who has ever
  built this tree means the copy sitting in out/. The install would then appear
  to succeed while /Library/Extensions, /Library/Filesystems, and
  /Library/LaunchDaemons stayed empty. All three are forced non-relocatable so
  they land where the package says.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>BundleIsRelocatable</key><false/>
		<key>BundleIsVersionChecked</key><true/>
		<key>BundleOverwriteAction</key><string>upgrade</string>
		<key>RootRelativeBundlePath</key><string>Library/Extensions/ext2fs.kext</string>
	</dict>
	<dict>
		<key>BundleIsRelocatable</key><false/>
		<key>BundleIsVersionChecked</key><true/>
		<key>BundleOverwriteAction</key><string>upgrade</string>
		<key>RootRelativeBundlePath</key><string>Library/Filesystems/ext2fs.fs</string>
	</dict>
	<dict>
		<key>BundleIsRelocatable</key><false/>
		<key>BundleIsVersionChecked</key><true/>
		<key>BundleOverwriteAction</key><string>upgrade</string>
		<key>RootRelativeBundlePath</key><string>Library/LaunchDaemons/com.beako.ext2fs.plist</string>
	</dict>
</array>
</plist>
